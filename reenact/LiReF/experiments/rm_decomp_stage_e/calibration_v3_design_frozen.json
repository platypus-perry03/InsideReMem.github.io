    "v2_1_1_artifact_modification_allowed": false,
    "v2_v2_1_v2_1_1_item_reuse_allowed": false
  },
  "feature": {
    "operationalized_name": "arithmetic composition vs selector-guided value retrieval after matched multi-hop binding",
    "arithmetic_condition": "Resolve target label to case, resolve two value keys in a common ledger, and apply the stated ADD/SUB terminal rule.",
    "selector_condition": "Resolve target label to case, resolve two value keys in a common ledger, and use an arbitrary seal/tag match to select the active entry.",
    "shared_steps": [
      "identify_question_target_label",
      "resolve_label_to_case_key",
      "read_case_terminal_instruction_and_two_value_keys",
      "resolve_two_values_in_common_ledger",
      "choose_or_derive_one_numeric_answer"
    ],
    "manipulated_terminal_rule": "arithmetic_composition_vs_selector_guided_retrieval",
    "reasoning_memorization_dataset_claim_allowed": false,
    "pure_arithmetic_effect_claim_allowed": false,
    "perfect_exposure_invariance_claim_allowed": false,
    "calibration_pass_interpretation": "The two operationalized conditions have sufficiently overlapping baseline difficulty for a controlled Pilot comparison."
  },
  "prompt_output_contract": {
    "template": "Q: {question}\nAnswer with one Arabic numeral only.\nA: ",
    "answer_format": "one_canonical_arabic_integer",
    "do_sample": false,
    "num_beams": 1,
    "max_new_tokens": 1,
    "accepted_aliases_allowed": false,
    "units_allowed": false,
    "explanations_allowed": false,
    "equations_allowed": false,
    "punctuation_allowed": false,
    "normalization_order": [
      "decode_generated_suffix_token_only",
      "unicode_nfkc",
      "strip_outer_whitespace",
      "require_full_match_regex_[0-9]+",
      "exact_match_canonical_answer"
    ],
    "metric_name": "one_token_unrestricted_generation_accuracy",
    "long_form_generation_claim_allowed": false
  },
  "pair_invariants": {
    "required": [
      "byte_identical_context_within_pair",
      "identical_entity_and_label_set",
      "identical_label_to_case_bindings",
      "identical_case_and_value_key_set",
      "identical_value_ledger",
      "identical_arithmetic_and_selector_blocks",
      "identical_question_form_except_target_label",
      "identical_output_instruction",
      "identical_answer_digit_length",
      "identical_answer_continuation_token_count",
      "exact_prompt_token_count_match"
    ],
    "condition_specific": [
      "question_target_label",
      "canonical_answer",
      "primary_alternative",
      "absolute_answer_exposure_regime"
    ]
  },
  "multi_hop_matching": {
    "both_channels_require_label_to_case_binding": true,
    "both_channels_require_two_value_key_resolution": true,
    "both_channels_use_common_value_ledger": true,
    "question_contains_case_or_value_key": false,
    "keys_are_alphabetic_only": true,
    "paired_keys_have_equal_token_count": true,
    "selector_requires_tag_match_between_two_entries": true,
    "selector_correct_and_alternative_each_appear_once": true,
    "arithmetic_correct_and_alternative_absent_as_numeric_mentions": true
  },
  "within_condition_exposure_matched_scoring": {
    "arithmetic_correct_exposure": "absent_from_context",
    "arithmetic_alternative_exposure": "absent_from_context",
    "selector_correct_exposure": "appears_once_in_value_ledger",
    "selector_alternative_exposure": "appears_once_in_value_ledger",
    "absolute_exposure_regime_equal_across_conditions": false,
    "interpretation_limit": "D_k is a calibrated difficulty contrast and not a perfectly exposure-invariant terminal-rule effect.",
    "cross_condition_canonical_answer_as_primary_alternative_allowed": false
  },
  "numeric_design": {
    "candidate_value_min": 30,
    "candidate_value_max": 69,
    "delta_min": 2,
    "delta_max": 9,
    "candidate_pair_distance_formula": "2_times_delta",
    "candidate_pair_distance_min": 4,
    "candidate_pair_distance_max": 18,
    "candidate_pair_distance_must_be_even": true,
    "candidate_pair_values_same_parity": true,
    "midpoint_must_be_integer": true,
    "answer_digit_length": 2,
    "answer_continuation_token_count": 1,
    "candidate_pairs_per_template": 2,
    "numeric_seed": 20260831,
    "all_correct_alternative_operand_and_ledger_values_must_be_collision_free": true,
    "collision_action": "reject_numeric_block_and_deterministically_generate_next_block",
    "reuse_prior_version_numeric_block_allowed": false
  },
  "arithmetic_primary_foil": {
    "rule": "wrong_operation_result",
    "add_or_warming_correct": "start_plus_delta",
    "add_or_warming_alternative": "start_minus_delta",
    "subtract_or_cooling_correct": "start_minus_delta",
    "subtract_or_cooling_alternative": "start_plus_delta",
    "random_offset_foil_allowed": false,
    "start_or_delta_as_primary_foil_allowed": false,
    "post_result_foil_change_allowed": false,
    "negative_out_of_range_or_collision_action": "reject_numeric_block_and_deterministically_generate_next_block"
  },
  "teacher_forced_scoring": {
    "primary_metric": "within_condition_exposure_matched_template_level_candidate_log_odds_contrast",
    "arithmetic_margin_formula": "M_A(x)=logP(y_arithmetic_correct|x)-logP(y_arithmetic_alt|x)",
    "selector_margin_formula": "M_S(x)=logP(y_selector_correct|x)-logP(y_selector_alt|x)",
    "template_contrast_formula": "D_k=mean_f(M_A(x_arithmetic,f)-M_S(x_selector,f))",
    "forced_choice_correct_rule": "condition_margin_greater_than_zero",
    "forced_choice_tie_rule": "margin_less_than_or_equal_to_zero_is_incorrect",
    "joint_prompt_answer_tokenization_required": true,
    "score_answer_suffix_tokens_only": true,
    "include_eos_in_answer_score": false,
    "include_newline_in_answer_score": false,
    "secondary_metrics": [
      "condition_candidate_forced_choice_accuracy",
      "one_token_unrestricted_generation_accuracy",
      "raw_canonical_log_probability",
      "per_token_geometric_probability",
      "arithmetic_no_change_or_operand_diagnostic_foil_log_odds",
      "selector_inactive_entry_foil_log_odds",
      "condition_margin_distribution",
      "template_cluster_overlap"
    ]
  },
  "counterbalance": {
